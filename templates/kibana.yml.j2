---
server.publicBaseUrl: "https://{{ kibana_domain }}"
server.ssl.enabled: false
server.name: "{{ inventory_hostname }}"
server.host: "0.0.0.0"
server.port: {{ kibana_cont_port }}
# ElasticSearch
elasticsearch.hosts: ["http://{{ kibana_es_lb_addr }}:{{ kibana_es_lb_port }}"]
elasticsearch.username: "{{ kibana_es_lb_user | mandatory }}"
elasticsearch.password: "{{ kibana_es_lb_pass | mandatory }}"
# XPack
xpack.security.enabled: true
xpack.reporting.enabled: true
xpack.reporting.roles.enabled: false
xpack.reporting.csv.maxSizeBytes: 50mb
# logging
logging.json: true
logging.root.level: "{{ kibana_log_level }}"
